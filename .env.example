# Copy to .env locally. Replace placeholders only in your private deployment.
# Never commit .env or paste secrets into chat.
MOCK_MODE=true

# --- Database & queue connection ---
# On a managed host (Render, Railway, Fly, etc.) set DATABASE_URL and REDIS_URL
# to the connection strings the host gives you for its Postgres/Redis add-ons -
# these take priority when set. SSL/TLS are inferred automatically (Postgres
# defaults to on for DATABASE_URL; set DATABASE_SSL=false to disable. Redis
# TLS is on automatically for a rediss:// URL).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# REDIS_URL=redis://:password@host:6379
#
# For local dev / docker-compose, the discrete vars below are used instead
# whenever DATABASE_URL / REDIS_URL are unset:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=essential
PGPASSWORD=essential_dev
PGDATABASE=essential
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Facebook Page connection used by the POC's live-mode gate
FB_PAGE_ID=<your_facebook_page_id>
FB_PAGE_ACCESS_TOKEN=<your_client_authorized_page_access_token>

# Public/signed URL base for media that a platform must retrieve
PUBLIC_MEDIA_BASE_URL=https://your-public-media-host.example/media

# Optional platform variables for the adapters in the full POC
INSTAGRAM_IG_ID=<your_instagram_professional_account_id>
META_ACCESS_TOKEN=<your_client_authorized_instagram_or_meta_token>
LINKEDIN_ACCESS_TOKEN=<your_client_authorized_linkedin_token>
LINKEDIN_AUTHOR_URN=<urn:li:organization:your_id>
LINKEDIN_VERSION=202601
TIKTOK_ACCESS_TOKEN=<your_client_authorized_tiktok_token>
X_ACCESS_TOKEN=<your_client_authorized_x_token>
YOUTUBE_ACCESS_TOKEN=<your_client_authorized_youtube_token>
PINTEREST_ACCESS_TOKEN=<your_client_authorized_pinterest_token>
PINTEREST_BOARD_ID=<your_pinterest_board_id>
THREADS_ACCESS_TOKEN=<your_client_authorized_threads_token>
THREADS_USER_ID=<your_threads_user_id>
GOOGLE_BUSINESS_ACCESS_TOKEN=<your_client_authorized_business_profile_token>
